# ===== typeless-local configuration =====
# Copy this file to .env and fill in your values.

# --- LLM API (OpenAI-compatible; DeepSeek / Qwen / GLM / SiliconFlow / OpenAI) ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# --- whisper.cpp ASR server ---
WHISPER_BIN=build/vulkan/bin/whisper-server.exe
# small = fast; large-v3-turbo = more accurate (12GB VRAM handles both)
WHISPER_MODEL=models/ggml-large-v3-turbo.bin
WHISPER_VAD_MODEL=models/ggml-silero-v6.2.0.bin
WHISPER_PORT=8178
WHISPER_THREADS=6
# Optional whisper steering prompt (improves zh punctuation, +0.5s/req on turbo)
WHISPER_PROMPT=
# auto = robust for zh/en mixed speech (+1.3s); pin "zh" or "en" for speed
WHISPER_LANGUAGE=auto

# --- Dictation client ---
# Set true if you mainly speak English; false keeps Chinese punctuation style
DICTATE_ENGLISH_ONLY=false
